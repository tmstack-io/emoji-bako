            "value": "Sync"
          }
        }
      }
    },
    "同期から外す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from Sync"
          }
        }
      }
    },
    "同期から外す…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove from Sync…"
          }
        }
      }
    },
    "同期しているすべてのMacの使用回数を消します。オフラインのMacでまだ届いていない使用回数も消えます。この操作は取り消せません。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Usage counts on all synced Macs will be cleared, including counts from offline Macs that have not arrived yet. This cannot be undone."
          }
        }
      }
    },
    "同期中のMac": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Synced Macs"
          }
        }
      }
    },
    "情報": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About"
          }
        }
      }
    },
    "最終更新: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last updated: %@"
          }
        }
      }
    },
    "検索を終了 (Esc)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close search (Esc)"
          }
        }
      }
    },
    "現在のバージョンは%@です。ダウンロードページから新しいDMGを入手し、アプリを置き換えてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are using version %@. Download the new DMG from the download page and replace the app."
          }
        }
      }
    },
    "終了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "絵文字ではなく元の内容が貼り付けられる場合は、長くしてください。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increase this if the previous clipboard content gets pasted instead of the emoji."
          }
        }
      }
    },
    "絵文字を検索": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search emoji"
          }
        }
      }
    },
    "表示を消す": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dismiss"
          }
        }
      }
    },
    "設定...": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settings..."
          }
        }
      }
    },
    "許可すると、この画面は自動で閉じます。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This window closes automatically once permission is granted."
          }
        }
      }
    },
    "該当する絵文字がありません": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching emoji"
          }
        }
      }
    }
