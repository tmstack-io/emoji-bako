          "stringUnit": {
            "state": "translated",
            "value": "Launch at login"
          }
        }
      }
    },
    "ログイン時の起動を変更できませんでした: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not change launch at login: %@"
          }
        }
      }
    },
